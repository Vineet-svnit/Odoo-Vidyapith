generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AuditLog {
  id         String   @id
  userId     String
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  createdAt  DateTime @default(now())
  User       User     @relation(fields: [userId], references: [id])
}

model Driver {
  id              String       @id
  userId          String       @unique
  firstName       String
  lastName        String
  licenseNumber   String       @unique
  licenseCategory String
  licenseExpiry   DateTime
  status          DriverStatus @default(ON_DUTY)
  safetyScore     Float?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime
  User            User         @relation(fields: [userId], references: [id])
  Trip            Trip[]
}

model Expense {
  id          String   @id
  vehicleId   String?
  tripId      String?
  category    String
  description String?
  amount      Float
  expenseDate DateTime
  createdAt   DateTime @default(now())
  createdBy   String
  Trip        Trip?    @relation(fields: [tripId], references: [id])
  Vehicle     Vehicle? @relation(fields: [vehicleId], references: [id])
}

model FuelLog {
  id            String   @id
  vehicleId     String
  liters        Float
  cost          Float
  pricePerLiter Float
  odometer      Float
  fuelDate      DateTime
  createdAt     DateTime @default(now())
  createdBy     String
  Vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])
}

model InvitationToken {
  id        String   @id
  token     String   @unique
  email     String
  role      Role
  invitedBy String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model MaintenanceLog {
  id          String    @id
  vehicleId   String
  serviceType String
  description String?
  cost        Float
  odometer    Float
  serviceDate DateTime
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  createdBy   String
  Vehicle     Vehicle   @relation(fields: [vehicleId], references: [id])
}

model Notification {
  id        String   @id
  userId    String
  type      String
  message   String
  metadata  Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Trip {
  id               String     @id
  vehicleId        String
  driverId         String
  cargoWeight      Float
  cargoDescription String?
  origin           String
  destination      String
  status           TripStatus @default(DRAFT)
  startOdometer    Float?
  endOdometer      Float?
  scheduledStart   DateTime?
  actualStart      DateTime?
  actualEnd        DateTime?
  issueReported    Boolean    @default(false)
  issueDescription String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime
  createdBy        String
  Expense          Expense[]
  Driver           Driver     @relation(fields: [driverId], references: [id])
  Vehicle          Vehicle    @relation(fields: [vehicleId], references: [id])
}

model User {
  id           String     @id
  email        String     @unique
  passwordHash String
  role         Role
  createdAt    DateTime   @default(now())
  updatedAt    DateTime
  invitedBy    String?
  AuditLog     AuditLog[]
  Driver       Driver?
  User         User?      @relation("UserToUser", fields: [invitedBy], references: [id])
  other_User   User[]     @relation("UserToUser")
}

model Vehicle {
  id              String           @id
  name            String
  model           String
  licensePlate    String           @unique
  type            VehicleType
  maxLoadCapacity Float
  odometer        Float
  status          VehicleStatus    @default(AVAILABLE)
  acquisitionCost Float?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime
  Expense         Expense[]
  FuelLog         FuelLog[]
  MaintenanceLog  MaintenanceLog[]
  Trip            Trip[]
}

enum DriverStatus {
  ON_DUTY
  OFF_DUTY
  SUSPENDED
}

enum Role {
  FLEET_MANAGER
  DISPATCHER
  DRIVER
}

enum TripStatus {
  DRAFT
  DISPATCHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ISSUE_REPORTED
}

enum VehicleStatus {
  AVAILABLE
  ON_TRIP
  IN_SHOP
  OUT_OF_SERVICE
}

enum VehicleType {
  TRUCK
  VAN
  BIKE
}
